{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soheil2004",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "916f26cb-28c7-4cf8-a3ed-3f884b31727d","database_name": "Soheil2004" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "004781ff90f94683a62802e63a578017" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
